# In development, leave blank or point to localhost:5000/api
# In production, set this to your deployed backend URL + /api (e.g. on Vercel, Netlify, or Render)
VITE_API_URL=https://your-backend-service.onrender.com/api

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
