# Port the backend will listen on (Render/Heroku/Railway set this automatically)
PORT=5000

# MongoDB Atlas connection string (keep your username and password secure!)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/MealShare?retryWrites=true&w=majority

# Secret key used for signing JWT tokens (generate a long, random string in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Allowed frontend origin(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# Node environment (production or development)
NODE_ENV=production
